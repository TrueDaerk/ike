<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Ike</string>
	<key>CFBundleDisplayName</key>
	<string>Ike</string>
	<key>CFBundleIdentifier</key>
	<string>dev.ike.launcher</string>
	<key>CFBundleVersion</key>
	<string>1.0</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleExecutable</key>
	<string>ike-launcher</string>
	<key>CFBundleIconFile</key>
	<string>ike</string>
	<key>LSMinimumSystemVersion</key>
	<string>11.0</string>
	<!-- LaunchServices runs a bundle whose executable is a shell script under
	     Rosetta (arch → i386, proc_translated → 1); the translated preference
	     is inherited down to the login shell ike-gui re-execs through, so an
	     arch-conditional profile (e.g. Homebrew's arm64 branch) takes the
	     Intel path and /opt/homebrew/bin never reaches PATH (#1614). Prefer
	     the native slice; Intel Macs fall through to x86_64. -->
	<key>LSArchitecturePriority</key>
	<array>
		<string>arm64</string>
		<string>x86_64</string>
	</array>
</dict>
</plist>
